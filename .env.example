# ==============================================================================
# EDUEXAM — CONFIGURATION FRONTEND PUBLIQUE (.env.example)
# Projet Firebase pré-configuré : appcorrection
# ==============================================================================
# RÈGLE DE SÉCURITÉ ABSOLUE :
# - Seules les clés d'identification cliente Firebase (VITE_FIREBASE_*) peuvent
#   figurer dans votre fichier .env local ou dans les Variables GitHub Actions.
# - NE PLACEZ JAMAIS de clé privée Firebase Admin, de mot de passe professeur,
#   ni de clé API d'envoi d'e-mail (Resend, Brevo, SMTP) dans un fichier VITE_* !
#   Ces secrets doivent être configurés EXCLUSIVEMENT dans Firebase Secret Manager
#   (`firebase functions:secrets:set ...`) ou les variables serveur privées.
# ==============================================================================

# Mode backend :
# - "auto" (défaut) : utilise Firebase ("appcorrection") dès que VITE_FIREBASE_API_KEY
#   est renseignée, sinon bascule sur le serveur API sécurisé (/api).
# - "firebase" : force l'utilisation exclusive de Firebase (production GitHub Pages).
# - "api" : utilise le serveur backend Node/Express sécurisé.
VITE_BACKEND_MODE=auto

# Identifiants publics Web de votre application Firebase "appcorrection"
# (Console Firebase > Paramètres du projet > Vos applications > Application Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=appcorrection.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=appcorrection
VITE_FIREBASE_STORAGE_BUCKET=appcorrection.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Région des Cloud Functions Firebase (par défaut : europe-west1)
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1

# Optionnel : Clé publique de site reCAPTCHA v3 / Enterprise pour Firebase App Check
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Optionnel : URL du backend API si hébergé séparément (laisser vide en local / proxy)
VITE_API_BASE_URL=
